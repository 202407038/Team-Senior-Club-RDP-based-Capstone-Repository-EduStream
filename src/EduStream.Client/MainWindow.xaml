<Window x:Class="EduStream.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        mc:Ignorable="d"
        Title="EduStream Client"
        Height="740"
        Width="520"
        MinHeight="600"
        MinWidth="480"
        Background="{StaticResource BrushBgPrimary}"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ==========================================================
             1) 참가 화면: 연결 전(IsConnected = False)에만 표시
             이름 / 호스트 IP / 포트 / 방 비밀번호 / 세션 참여
             ========================================================== -->
        <Grid Margin="16"
              Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <Border Style="{StaticResource PanelCard}"
                    Width="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="28">
                <StackPanel>
                    <TextBlock Text="EDUSTREAM"
                               Foreground="{StaticResource BrushAccentPurple}"
                               FontSize="28"
                               FontWeight="ExtraBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Margin="0,4,0,24"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"
                               Text="수강생 클라이언트" />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="학생 이름" />
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="호스트 IP" />
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="포트" />
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- TODO(ViewModel): RoomPassword 속성 추가 후 연결.
                         비밀번호 없는 방은 비워 두고 참여하면 됩니다. -->
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="방 비밀번호 (없으면 비워 두세요)" />
                    <TextBox Style="{StaticResource DarkTextBox}"
                             Text="{Binding RoomPassword, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,20,0,0"
                            Height="40"
                            Content="세션 참여"
                            Command="{Binding JoinSessionCommand}" />

                    <!-- 연결 중 표시 -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Style="{StaticResource LoadingProgressBar}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="세션에 연결하는 중..."
                                   Foreground="{StaticResource BrushAccentPurple}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 오류/안내 메시지 -->
                    <Border Margin="0,14,0,0"
                            Padding="10"
                            CornerRadius="8"
                            Background="{StaticResource BrushBgElevated}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccentTeal}" />
                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentError}" />
                                        <Setter Property="Background" Value="#2A1E22" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentTeal}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentError}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==========================================================
             2) 강의 화면: 연결 후(IsConnected = True)에만 표시
             왼쪽: 교수자 공유 화면 / 오른쪽: 채팅 → 파일 → 로그 세로 배치
             ========================================================== -->
        <Grid Margin="16"
              Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" MinWidth="300" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 교수자 공유 화면 -->
            <Border Grid.Column="0"
                    Background="#000000"
                    CornerRadius="12"
                    BorderBrush="#333333"
                    BorderThickness="1">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Image Source="{Binding DisplaySource}" />
                    </Viewbox>

                    <!-- 공유 대기 / 연결 / 오류 안내 -->
                    <Border Background="#CC0A0A0A"
                            Visibility="{Binding HasRemoteFrame, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420"
                                    Margin="24">
                            <TextBlock Text="🖥️"
                                       FontSize="40"
                                       Margin="0,0,0,16"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding PlaceholderTitle}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding PlaceholderSubtitle}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Margin="16"
                            Padding="10,6"
                            Background="#CC000000"
                            CornerRadius="8">
                        <TextBlock Foreground="{StaticResource BrushAccentTeal}"
                                   FontWeight="SemiBold"
                                   Text="{Binding RenderStatus}" />
                    </Border>

                    <Border VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="16"
                            Padding="10,6"
                            Background="#CC000000"
                            CornerRadius="8">
                        <TextBlock Foreground="{StaticResource BrushTextMuted}"
                                   FontWeight="SemiBold"
                                   Text="{Binding FrameFreshness}" />
                    </Border>
                </Grid>
            </Border>

            <!-- 오른쪽: 접속 상태 + 채팅 → 파일 → 로그 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 접속 상태 + 세션 나가기 -->
                <Border Grid.Row="0"
                        Padding="12"
                        CornerRadius="8"
                        Background="{StaticResource BrushBgElevated}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,0"
                                Content="세션 나가기"
                                Command="{Binding DisconnectCommand}" />
                        <Ellipse DockPanel.Dock="Left"
                                 Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Fill="{Binding ConnectionState, Converter={StaticResource StateToBrush}}" />
                        <TextBlock VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} · {1}">
                                    <Binding Path="DisplayName" />
                                    <Binding Path="ConnectionState" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- 원격 제어 허용 / 즉시 중단 (접속 상태 근처) -->
                <Border Grid.Row="2"
                        Padding="12,8"
                        CornerRadius="8"
                        Background="{StaticResource BrushBgElevated}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}"
                                Padding="12,0"
                                Content="즉시 중단"
                                Command="{Binding StopRemoteControlCommand}" />
                        <CheckBox VerticalAlignment="Center"
                                  Foreground="{StaticResource BrushTextSecondary}"
                                  Content="교수자 원격 제어 허용"
                                  IsChecked="{Binding AllowRemoteControl, Mode=TwoWay}" />
                    </DockPanel>
                </Border>

                <!-- 채팅 -->
                <Border Grid.Row="4" Style="{StaticResource PanelCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="채팅" />

                        <ListBox Grid.Row="1"
                                 Margin="0,10,0,0"
                                 Style="{StaticResource DarkListBox}"
                                 ItemsSource="{Binding ChatMessages}"
                                 ItemTemplate="{StaticResource ChatBubbleTemplate}" />

                        <DockPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="전송"
                                    Command="{Binding SendChatCommand}" />
                            <!-- Enter 전송 (한글 조합 중 Enter는 KeyBinding이 실행되지 않음) -->
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendChatCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 파일 -->
                <Border Grid.Row="6" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="파일" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   Text="{Binding DownloadStatus}" />
                        <ListBox Margin="0,8,0,0"
                                 Height="90"
                                 Style="{StaticResource DarkListBox}"
                                 ItemsSource="{Binding DownloadedFiles}"
                                 ItemTemplate="{StaticResource FileLineTemplate}" />
                    </StackPanel>
                </Border>

                <!-- 로그 (접기/펼치기) -->
                <Border Grid.Row="8" Style="{StaticResource PanelCard}">
                    <Expander IsExpanded="False"
                              Foreground="{StaticResource BrushTextPrimary}"
                              Header="로그">
                        <ListBox Margin="0,8,0,0"
                                 Height="100"
                                 Style="{StaticResource DarkListBox}"
                                 ItemsSource="{Binding ActivityLogs}"
                                 ItemTemplate="{StaticResource LogLineTemplate}" />
                    </Expander>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
