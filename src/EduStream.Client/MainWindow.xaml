<Window x:Class="EduStream.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EduStream Client"
        Height="820"
        Width="1360"
        MinHeight="640"
        MinWidth="960"
        Background="{StaticResource BrushBgPrimary}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" MinWidth="320" MaxWidth="440" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#000000"
                CornerRadius="12"
                BorderBrush="#333333"
                BorderThickness="1">
            <Grid>
                <Viewbox Stretch="Uniform">
                    <Image Source="{Binding DisplaySource}" />
                </Viewbox>

                <Border Background="#CC0A0A0A"
                        Visibility="{Binding HasRemoteFrame, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="420"
                                Margin="24">
                        <TextBlock Text="🖥️"
                                   FontSize="40"
                                   Margin="0,0,0,16"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PlaceholderTitle}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,12,0,0"
                                   Text="{Binding PlaceholderSubtitle}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#CC0A0A0A"
                        Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Style="{StaticResource LoadingProgressBar}" />
                        <TextBlock Margin="0,16,0,0"
                                   Text="세션에 연결하는 중..."
                                   Foreground="{StaticResource BrushAccentPurple}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="16"
                        Padding="10,6"
                        Background="#CC000000"
                        CornerRadius="8">
                    <TextBlock Foreground="{StaticResource BrushAccentTeal}"
                               FontWeight="SemiBold"
                               Text="{Binding RenderStatus}" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="EDUSTREAM"
                               Foreground="{StaticResource BrushAccentPurple}"
                               FontSize="24"
                               FontWeight="ExtraBold" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource BrushTextMuted}"
                               Text="수강생 클라이언트" />
                </StackPanel>

                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="세션 연결" />

                        <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="표시 이름" />
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="호스트" />
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="포트" />
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="0,14,0,0"
                                    Height="36"
                                    Content="세션 참여"
                                    Command="{Binding JoinSessionCommand}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                            <Border Margin="0,14,0,0"
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{StaticResource BrushBgElevated}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatusDot}"
                                             Fill="{Binding ConnectionState, Converter={StaticResource StateToBrush}}"
                                             Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Text="강의 세션 연결 상태" />
                                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="14"
                                                   Text="{Binding DisplayName, StringFormat='{}{0} 님으로 수강 중'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="0,12,0,0"
                                    Height="36"
                                    Content="연결 종료"
                                    Command="{Binding DisconnectCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="시스템 알림" />
                        <Border Margin="0,10,0,0"
                                Padding="10"
                                CornerRadius="8"
                                Background="{StaticResource BrushBgElevated}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentTeal}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentError}" />
                                            <Setter Property="Background" Value="#2A1E22" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentTeal}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccentError}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="실시간 채팅" />

                        <ListBox Margin="0,10,0,0"
                                 Height="180" 
                                 Style="{StaticResource DarkListBox}"
                                 ItemsSource="{Binding ChatMessages}"
                                 ItemTemplate="{StaticResource ChatBubbleTemplate}" />

                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right"
                                    Width="88"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="전송"
                                    Command="{Binding SendChatCommand}" />
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="파일 수신" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   Text="{Binding DownloadStatus}" />

                        <ListBox Margin="0,10,0,0"
                                 Height="90"
                                 Style="{StaticResource DarkListBox}"
                                 ItemsSource="{Binding DownloadedFiles}"
                                 ItemTemplate="{StaticResource FileLineTemplate}" />

                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,0"
                                    Content="화면 수신 테스트"
                                    Command="{Binding SimulateScreenRenderCommand}" />
                            <Button Style="{StaticResource GhostButton}"
                                    Content="파일 수신 테스트"
                                    Command="{Binding SimulateFileReceiveCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="활동 로그" />
                        <ListBox Margin="0,10,0,0"
                                 MaxHeight="140"
                                 Style="{StaticResource DarkListBox}"
                                 ItemsSource="{Binding ActivityLogs}"
                                 ItemTemplate="{StaticResource LogLineTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>