<Window x:Class="EduStream.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        mc:Ignorable="d"
        Title="EduStream Client"
        Height="820"
        Width="1360"
        MinHeight="640"
        MinWidth="960"
        Background="{StaticResource BrushBgPrimary}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" MinWidth="320" MaxWidth="440" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#000000"
                CornerRadius="12"
                BorderBrush="#333333"
                BorderThickness="1">
            <Grid>
                <Viewbox Stretch="Uniform">
                    <Image Source="{Binding DisplaySource}" />
                </Viewbox>
                <wfi:WindowsFormsHost x:Name="RdpHost" Visibility="{Binding IsRdpActive, Converter={StaticResource BoolToVis}}" />
                <Border Background="#CC0A0A0A"
                        Visibility="{Binding HasRemoteFrame, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="420"
                                Margin="24">
                        <TextBlock Text="🖥️"
                                   FontSize="40"
                                   Margin="0,0,0,16"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PlaceholderTitle}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock Margin="0,12,0,0"
                                   Text="{Binding PlaceholderSubtitle}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#CC0A0A0A"
                        Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Style="{StaticResource LoadingProgressBar}" />
                        <TextBlock Margin="0,16,0,0"
                                   Text="세션에 연결하는 중..."
                                   Foreground="{StaticResource BrushAccentPurple}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="16"
                        Padding="10,6"
                        Background="#CC000000"
                        CornerRadius="8">
                    <TextBlock Foreground="{StaticResource BrushAccentTeal}"
                               FontWeight="SemiBold"
                               Text="{Binding RenderStatus}" />
                </Border>
                <Border VerticalAlignment="Top"
        HorizontalAlignment="Right"
        Margin="16"
        Padding="10,6"
        Background="#CC000000"
        CornerRadius="8">
                    <TextBlock Foreground="{StaticResource BrushTextMuted}"
               FontWeight="SemiBold"
               Text="{Binding FrameFreshness}" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="EDUSTREAM"
                               Foreground="{StaticResource BrushAccentPurple}"
                               FontSize="24"
                               FontWeight="ExtraBold" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource BrushTextMuted}"
                               Text="수강생 클라이언트" />
                </StackPanel>

                <Border Margin="0,0,0,12"
        Padding="12"
        CornerRadius="8"
        Background="{StaticResource BrushBgElevated}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                  Fill="{Binding ConnectionState, Converter={StaticResource StateToBrush}}" />
                        <TextBlock VerticalAlignment="Center"
                   Foreground="{StaticResource BrushTextPrimary}"
                   FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} · {1}">
                                    <Binding Path="DisplayName" />
                                    <Binding Path="ConnectionState" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="시스템 알림" />
                        <Border Margin="0,10,0,0"
                                Padding="10"
                                CornerRadius="8"
                                Background="{StaticResource BrushBgElevated}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentTeal}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentError}" />
                                            <Setter Property="Background" Value="#2A1E22" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentTeal}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccentError}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <TabControl Style="{StaticResource DarkTabControl}" Margin="0,0,0,12">
                    <TabItem Header="채팅" Margin="0,0,-1,0">
                        <StackPanel Margin="0,10,0,0">
                            <ListBox Height="220"
                     Style="{StaticResource DarkListBox}"
                     ItemsSource="{Binding ChatMessages}"
                     ItemTemplate="{StaticResource ChatBubbleTemplate}" />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right"
                        Width="88"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="전송"
                        Command="{Binding SendChatCommand}" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="파일" Margin="4,0,-5,0">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Foreground="{StaticResource BrushTextSecondary}"
                       Text="{Binding DownloadStatus}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,6" Text="강의 파일" />
                            <ListBox Height="160"
                     Style="{StaticResource DarkListBox}"
                     ItemsSource="{Binding SessionFiles}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,0"
                                                    Content="다운로드" Command="{Binding DownloadCommand}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayText}" Foreground="#DDDDDD" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Status}" Foreground="#999999" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,0" Text="받은 파일" />
                            <ListBox Margin="0,10,0,0"
                     Height="160"
                     Style="{StaticResource DarkListBox}"
                     ItemsSource="{Binding DownloadedFiles}"
                     ItemTemplate="{StaticResource FileLineTemplate}" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="로그" Margin="8,0,-8,0">
                        <ListBox Margin="0,10,0,0"
                 Height="220"
                 Style="{StaticResource DarkListBox}"
                 ItemsSource="{Binding ActivityLogs}"
                 ItemTemplate="{StaticResource LogLineTemplate}" />
                    </TabItem>
                    <TabItem Header="설정" Margin="11,0,-11,0">
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="RDP" />
                                <TextBlock Margin="0,8,0,0"
               Foreground="{StaticResource BrushTextSecondary}"
               Text="{Binding RdpStatusText}" />
                                <TextBlock Text="교수자에게 별도로 받은 초대 비밀번호" Margin="0,8,0,4" Foreground="{StaticResource BrushTextSecondary}" />
                                <PasswordBox x:Name="RdpPassword" Padding="8" />
                                <Button Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                        Content="RDP 연결" Click="ConnectRdp_Click" />
                                <Button Style="{StaticResource GhostButton}"
            Margin="0,8,0,0"
            Content="RDP 재접속"
            Command="{Binding ReconnectRdpCommand}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="개발자 테스트" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Style="{StaticResource GhostButton}"
                Margin="0,0,8,0"
                Content="화면 수신 테스트"
                Command="{Binding SimulateScreenRenderCommand}" />
                                    <Button Style="{StaticResource GhostButton}"
                Content="파일 수신 테스트"
                Command="{Binding SimulateFileReceiveCommand}" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="표시 이름" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="교수자 IP" />
                                    <TextBox Style="{StaticResource DarkTextBox}"
                                             Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Expander Header="고급 연결 설정 (기본 포트 5000)" IsExpanded="False"
                                          Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="포트 (교수자가 변경한 경우만)" />
                                        <TextBox Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Expander>
                                <!-- 이전 ConnectionCode 입력칸은 제거. LAN TLS 참가에는 별도 코드/신뢰 확인창이 없습니다. -->

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,6" Text="방 비밀번호 (설정된 경우)" />
                                <PasswordBox x:Name="RoomPasswordBox" Padding="8" />

                                <Button Style="{StaticResource PrimaryButton}"
                                        Margin="0,14,0,0"
                                        Height="36"
                                        Content="세션 참여"
                                        Command="{Binding JoinSessionCommand}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Foreground="{StaticResource BrushTextSecondary}"
                                           Text="현재 연결된 세션 정보입니다. 연결을 끊으려면 아래 버튼을 누르세요." 
                                           TextWrapping="Wrap" />
                                <Button Style="{StaticResource SecondaryButton}"
                                        Margin="0,14,0,0"
                                        Height="36"
                                        Content="연결 종료"
                                        Command="{Binding DisconnectCommand}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="원격 제어" />
                                <TextBlock Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap"
                                           Text="{Binding ControlStatusText}" />
                                <TextBlock Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="{Binding PermissionSummary}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="12,0"
                                            Content="즉시 중단" Command="{Binding StopControlNowCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" Padding="12,0"
                                            Content="{Binding ControlToggleLabel}" Command="{Binding ToggleControlPermissionCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" Padding="12,0"
                                            Content="{Binding ViewingToggleLabel}" Command="{Binding ToggleViewingPermissionCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
