<Window x:Class="EduStream.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        mc:Ignorable="d"
        Title="EduStream Client"
        Height="820"
        Width="1360"
        MinHeight="640"
        MinWidth="960"
        Background="{StaticResource BrushBgPrimary}"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PermissionPill" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Content" Value="OFF" />
            <Setter Property="Background" Value="#444444" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="13" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ControlPermissionPill" TargetType="Button" BasedOn="{StaticResource PermissionPill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AllowControl}" Value="True">
                    <Setter Property="Content" Value="ON" />
                    <Setter Property="Background" Value="{StaticResource BrushAccentPurple}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ViewingPermissionPill" TargetType="Button" BasedOn="{StaticResource PermissionPill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AllowViewing}" Value="True">
                    <Setter Property="Content" Value="ON" />
                    <Setter Property="Background" Value="{StaticResource BrushAccentPurple}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FileLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextTrimming="CharacterEllipsis" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource BrushAccentPurple}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Label" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushBgElevated}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushBgInput}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAccentError}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 상단바 -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="최소화" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="최대화" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="닫기" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Text="EDUSTREAM"
                           Foreground="{StaticResource BrushAccentPurple}"
                           FontWeight="ExtraBold"
                           FontSize="13" />
                <TextBlock DockPanel.Dock="Left"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="수강생 클라이언트"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="12" />
            </DockPanel>
        </Border>

    <Grid Grid.Row="1">
        <!-- 02 참가 화면 -->
        <Grid Margin="16" Visibility="{Binding IsLectureViewActive, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource PanelCard}"
                        MaxWidth="440"
                        Padding="28"
                        Margin="0,16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="EDUSTREAM"
                                   Foreground="{StaticResource BrushAccentPurple}"
                                   FontSize="24"
                                   FontWeight="ExtraBold" />
                        <TextBlock Margin="0,4,0,20"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Text="교수자가 개설한 세션에 참가합니다." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="학생 이름" />
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,6" Text="교수자 IP" />
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Text="교수자 화면에 표시된 IP를 입력하세요." />

                        <Expander Header="고급 설정 (기본 포트 5000)"
                                  IsExpanded="False"
                                  Margin="0,10,0,0"
                                  Foreground="{StaticResource BrushTextSecondary}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="포트 (교수자가 바꾼 경우에만)" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Expander>

                        <!-- 방 비밀번호는 비밀번호가 걸린 방일 때만 체크하고 입력한다. 비밀번호 없는 방은 비워 두는 것과 같다. -->
                        <CheckBox x:Name="UseRoomPasswordCheck"
                                  Margin="0,16,0,0"
                                  Foreground="{StaticResource BrushTextSecondary}"
                                  Content="비밀번호 입력"
                                  IsChecked="{Binding RoomPasswordRequired, Mode=TwoWay}"
                                  Unchecked="UseRoomPasswordCheck_Unchecked" />
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding IsChecked, ElementName=UseRoomPasswordCheck, Converter={StaticResource BoolToVis}}">
                            <PasswordBox x:Name="RoomPasswordBox" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Text="교수자가 따로 알려 준 방 비밀번호를 입력하세요." />
                        </StackPanel>

                        <Button Style="{StaticResource PrimaryButton}"
                                Margin="0,18,0,0"
                                Height="40"
                                Content="세션 참여"
                                Command="{Binding JoinSessionCommand}" />

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Style="{StaticResource LoadingProgressBar}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="세션에 연결하는 중..."
                                       Foreground="{StaticResource BrushAccentPurple}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Margin="0,14,0,0"
                                Padding="10"
                                CornerRadius="8"
                                Background="{StaticResource BrushBgElevated}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentTeal}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentError}" />
                                            <Setter Property="Background" Value="#2A1E22" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentTeal}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccentError}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- 03 강의 화면 -->
        <Grid Margin="16" Visibility="{Binding IsLectureViewActive, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" MinWidth="320" MaxWidth="440" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#000000"
                    CornerRadius="12"
                    BorderBrush="#333333"
                    BorderThickness="1">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Image Source="{Binding DisplaySource}" />
                    </Viewbox>
                    <wfi:WindowsFormsHost x:Name="RdpHost" Visibility="{Binding IsRdpActive, Converter={StaticResource BoolToVis}}" />
                    <!-- 화면 프레임(PNG)도 RDP 화면도 없을 때만 "연결 대기 중" 안내를 보여 준다. -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#CC0A0A0A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRemoteFrame}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRdpActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420"
                                    Margin="24">
                            <TextBlock Text="🖥️"
                                       FontSize="40"
                                       Margin="0,0,0,16"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PlaceholderTitle}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding PlaceholderSubtitle}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Background="#CC0A0A0A"
                            Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar Style="{StaticResource LoadingProgressBar}" />
                            <TextBlock Margin="0,16,0,0"
                                       Text="세션에 연결하는 중..."
                                       Foreground="{StaticResource BrushAccentPurple}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Margin="16"
                            Padding="10,6"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#CC000000" />
                                <Style.Triggers>
                                    <!-- PNG 프레임 방식의 상태 표시이므로 RDP 화면이 연결되면 숨긴다. -->
                                    <DataTrigger Binding="{Binding IsRdpActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{StaticResource BrushAccentTeal}"
                                   FontWeight="SemiBold"
                                   Text="{Binding RenderStatus}" />
                    </Border>
                    <Border VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="16"
                            Padding="10,6"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#CC000000" />
                                <Style.Triggers>
                                    <!-- PNG 프레임 방식의 상태 표시이므로 RDP 화면이 연결되면 숨긴다. -->
                                    <DataTrigger Binding="{Binding IsRdpActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="{StaticResource BrushTextMuted}"
                                   FontWeight="SemiBold"
                                   Text="{Binding FrameFreshness}" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 연결 상태 / 세션 나가기 -->
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource GhostButton}"
                                        Padding="12,0"
                                        Content="세션 나가기"
                                        Command="{Binding DisconnectCommand}" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                             Fill="{Binding ConnectionState, Converter={StaticResource StateToBrush}}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="DisplayName" />
                                                <Binding Path="ConnectionState" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 시스템 알림 -->
                    <Border Margin="0,0,0,12"
                            Padding="10"
                            CornerRadius="8"
                            Background="{StaticResource BrushBgElevated}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccentTeal}" />
                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentError}" />
                                        <Setter Property="Background" Value="#2A1E22" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentTeal}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentError}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- 채팅 -->
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="채팅" />
                            <ListBox x:Name="ChatListBox"
                                     Margin="0,10,0,0"
                                     Height="200"
                                     Style="{StaticResource DarkListBox}"
                                     ItemsSource="{Binding ChatMessages}"
                                     ItemTemplate="{StaticResource ChatBubbleTemplate}" />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right"
                                        Width="72"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="전송"
                                        Command="{Binding SendChatCommand}" />
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         TextWrapping="Wrap"
                                         MaxHeight="90"
                                         PreviewKeyDown="ChatInput_PreviewKeyDown"
                                         Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 파일 -->
                    <!-- 파일은 처음엔 접혀 있으므로, 새 파일이 등록되면 헤더 옆에 NEW!를 띄우고 펼치면 지운다. -->
                    <Expander IsExpanded="{Binding IsFilesPanelExpanded, Mode=TwoWay}"
                              Margin="0,0,0,12"
                              Foreground="{StaticResource BrushTextSecondary}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="파일" VerticalAlignment="Center" />
                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="8" VerticalAlignment="Center"
                                        Background="{StaticResource BrushAccentPurple}"
                                        Visibility="{Binding HasNewFiles, Converter={StaticResource BoolToVis}}"
                                        ToolTip="새 파일이 등록되어 있습니다">
                                    <TextBlock Text="NEW!" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource BrushBgPrimary}" />
                                </Border>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       Text="{Binding DownloadStatus}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,6" Text="강의 파일" />
                            <ListBox Height="130"
                                     Style="{StaticResource DarkListBox}"
                                     ItemsSource="{Binding SessionFiles}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,0"
                                                    Content="다운로드" Command="{Binding DownloadCommand}" />
                                            <StackPanel>
                                                <Button Style="{StaticResource FileLinkButton}"
                                                        Content="{Binding DisplayText}"
                                                        Command="{Binding DownloadCommand}"
                                                        ToolTip="클릭하면 다운로드합니다" />
                                                <TextBlock Text="{Binding Status}" Foreground="#999999" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,6" Text="받은 파일" />
                            <ListBox Height="110"
                                     Style="{StaticResource DarkListBox}"
                                     ItemsSource="{Binding DownloadedFiles}"
                                     ItemTemplate="{StaticResource FileLineTemplate}" />
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    </Grid>
</Window>
