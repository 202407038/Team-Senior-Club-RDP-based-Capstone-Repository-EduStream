<Window x:Class="EduStream.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EduStream Client"
        Height="860"
        Width="1280"
        MinHeight="760"
        MinWidth="1100"
        Background="#FFF6F8FB">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="24"
                Background="White"
                BorderBrush="#FFD5DFEC"
                BorderThickness="1"
                CornerRadius="18">
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="Bold" Text="학생 클라이언트" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="#FF5F6B79"
                           Text="세션 참가, 채팅, 파일 수신, 화면 수신 상태를 한 화면에서 확인하는 학생용 UI입니다."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Padding="20"
                        Background="White"
                        BorderBrush="#FFD5DFEC"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="세션 참가" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF5F6B79"
                                   Text="접속 정보와 표시 이름을 입력한 뒤 세션 참가/종료 버튼을 사용할 수 있습니다."
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                <TextBlock FontWeight="SemiBold" Text="표시 이름" />
                                <TextBox Margin="0,6,0,0"
                                         Padding="10,8"
                                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock FontWeight="SemiBold" Text="서버 IP" />
                                <TextBox Margin="0,6,0,0"
                                         Padding="10,8"
                                         Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock FontWeight="SemiBold" Text="포트" />
                                <TextBox Margin="0,6,0,0"
                                         Padding="10,8"
                                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <WrapPanel Grid.Row="4" Grid.ColumnSpan="3">
                                <Button Margin="0,0,10,0"
                                        Padding="18,10"
                                        Command="{Binding JoinSessionCommand}"
                                        Content="세션 참가" />
                                <Button Padding="18,10"
                                        Command="{Binding DisconnectCommand}"
                                        Content="연결 종료" />
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="20"
                        Background="White"
                        BorderBrush="#FFD5DFEC"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="연결 상태" />
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="현재 상태" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionState}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="세션 정보" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SessionSummary}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Text="최근 서버 메시지" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastServerMessage}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="6" Grid.Column="0" FontWeight="SemiBold" Text="최근 오류" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Foreground="#FFB02A37" Text="{Binding LastErrorMessage}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="8" Grid.Column="0" FontWeight="SemiBold" Text="최근 성공" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Foreground="#FF1D6F42" Text="{Binding LastSuccessMessage}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="20"
                        Background="White"
                        BorderBrush="#FFD5DFEC"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="파일 / 화면 수신 상태" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF5F6B79"
                                   Text="서버에서 실제 패킷을 수신하면 화면 프레임과 파일 저장 결과가 이 패널에 반영됩니다."
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="화면 수신 상태" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RenderStatus}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="다운로드 상태" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DownloadStatus}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Text="화면 상세" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ScreenDetail}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="6" Grid.Column="0" FontWeight="SemiBold" Text="파일 상세" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FileTransferDetail}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="8" Grid.Column="0" FontWeight="SemiBold" Text="채팅 상태" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ChatStatus}" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="다운로드된 파일" />
                        <ListBox Margin="0,10,0,0"
                                 MinHeight="90"
                                 BorderBrush="#FFD5DFEC"
                                 BorderThickness="1"
                                 ItemsSource="{Binding DownloadedFiles}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="20"
                        Background="White"
                        BorderBrush="#FFD5DFEC"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="실시간 채팅" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#FF5F6B79"
                                       Text="세션 연결 후 공지와 질문을 주고받는 영역입니다."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ListBox Grid.Row="2"
                                 Padding="8"
                                 BorderBrush="#FFD5DFEC"
                                 BorderThickness="1"
                                 ItemsSource="{Binding ChatMessages}" />

                        <DockPanel Grid.Row="4">
                            <Button DockPanel.Dock="Right"
                                    Width="110"
                                    Margin="12,0,0,0"
                                    Command="{Binding SendChatCommand}"
                                    Content="전송" />
                            <TextBox Padding="10,8"
                                     Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="20"
                        Background="White"
                        BorderBrush="#FFD5DFEC"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="활동 로그" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF5F6B79"
                                   Text="세션 참가, 종료, 채팅 전송, 파일 저장 등 현재까지의 클라이언트 동작을 기록합니다."
                                   TextWrapping="Wrap" />
                        <ListBox Margin="0,16,0,0" ItemsSource="{Binding ActivityLogs}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
