<Window x:Class="EduStream.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EduStream Client"
        Height="720"
        Width="1180"
        MinHeight="640"
        MinWidth="960">
    <Grid Margin="20">
        <Border Padding="20" CornerRadius="12" Background="#FFF0F5FB" BorderBrush="#FFC8DBEF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="Bold" Text="학생용 수신 대시보드" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF4C5F73"
                               Text="세션 참여, 채팅, 파일 수신, 화면 렌더링을 단계적으로 구현하기 위한 기본 뷰입니다."
                               TextWrapping="Wrap" />

                    <UniformGrid Margin="0,20,0,0" Columns="2">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock FontWeight="SemiBold" Text="서버 IP" />
                            <TextBox Margin="0,6,0,0" Padding="10,8" Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="포트" />
                            <TextBox Margin="0,6,0,0" Padding="10,8" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>

                    <WrapPanel Margin="0,20,0,0">
                        <Button Margin="0,0,10,10" Padding="18,10" Command="{Binding JoinSessionCommand}" Content="세션 참여" />
                        <Button Margin="0,0,10,10" Padding="18,10" Command="{Binding DisconnectCommand}" Content="연결 종료" />
                        <Button Margin="0,0,10,10" Padding="18,10" Command="{Binding SimulateScreenRenderCommand}" Content="화면 수신 테스트" />
                        <Button Margin="0,0,10,10" Padding="18,10" Command="{Binding SimulateFileReceiveCommand}" Content="파일 수신 테스트" />
                    </WrapPanel>

                    <Border Margin="0,14,0,0" Padding="16" Background="White" BorderBrush="#FFC8DBEF" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="연결 상태" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding ConnectionState}" />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="화면 렌더링 상태" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding RenderStatus}" />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="다운로드 상태" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding DownloadStatus}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="실시간 채팅" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Width="110" Margin="12,0,0,0" Command="{Binding SendChatCommand}" Content="질문 전송" />
                        <TextBox Padding="10,8" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <ListBox Margin="0,10,0,0" Height="160" ItemsSource="{Binding ChatMessages}" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="16" Background="White" BorderBrush="#FFC8DBEF" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="다운로드 파일 목록" />
                            <ListBox Margin="0,10,0,0" ItemsSource="{Binding DownloadedFiles}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Padding="16" Background="White" BorderBrush="#FFC8DBEF" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="활동 로그" />
                            <ListBox Margin="0,10,0,0" ItemsSource="{Binding ActivityLogs}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
