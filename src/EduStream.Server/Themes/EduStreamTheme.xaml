<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:EduStream.Core.Models;assembly=EduStream.Core">

    <!-- Brand palette -->
    <Color x:Key="BgPrimary">#121212</Color>
    <Color x:Key="BgSurface">#1A1A1A</Color>
    <Color x:Key="BgElevated">#252525</Color>
    <Color x:Key="BgInput">#2D2D2D</Color>
    <Color x:Key="BorderDefault">#2E2E2E</Color>
    <Color x:Key="AccentPurple">#BB86FC</Color>
    <Color x:Key="AccentTeal">#03DAC6</Color>
    <Color x:Key="AccentError">#CF6679</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#B0B0B0</Color>
    <Color x:Key="TextMuted">#888888</Color>

    <SolidColorBrush x:Key="BrushBgPrimary" Color="{StaticResource BgPrimary}" />
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource BgSurface}" />
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource BgElevated}" />
    <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource BgInput}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderDefault}" />
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource AccentPurple}" />
    <SolidColorBrush x:Key="BrushAccentTeal" Color="{StaticResource AccentTeal}" />
    <SolidColorBrush x:Key="BrushAccentError" Color="{StaticResource AccentError}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}" />

    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushBgSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{DynamicResource BrushBgInput}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrushAccentTeal}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushSelection}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Background" Value="{DynamicResource BrushAccentPurple}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushBgPrimary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushPrimaryHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccentError}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{DynamicResource BrushBgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccentTeal}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DarkListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource BrushListGround}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ChatBubbleTemplate" DataType="{x:Type models:ChatLine}">
        <Border Margin="0,2"
                Padding="10,8"
                CornerRadius="10"
                MaxWidth="320">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource BrushChatOther}" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSystem}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushChatSystem}" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrushChatSelf}" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock FontSize="11"
                           FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentTeal}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentPurple}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding Sender, Mode=OneWay}" />
                </TextBlock>
                <!-- 읽기 전용 TextBox라서 메시지를 드래그로 선택하고 Ctrl+C·우클릭으로 복사할 수 있다. -->
                <TextBox Margin="0,4,0,0"
                         Text="{Binding Message, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Foreground="{DynamicResource BrushTextPrimary}"
                         FontSize="13" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="LogLineTemplate">
        <TextBlock Text="{Binding}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource BrushTextMuted}"
                   Margin="0,2" />
    </DataTemplate>

    <DataTemplate x:Key="FileLineTemplate">
        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="📄"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LoadingProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Width" Value="140" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccentPurple}" />
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

</ResourceDictionary>
