<Window x:Class="EduStream.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        mc:Ignorable="d"
        Title="EduStream Server"
        Height="760"
        Width="1280"
        MinHeight="680"
        MinWidth="1080">
    <Grid Margin="20">
        <Border Padding="20" CornerRadius="12" Background="#FFF7F4EA" BorderBrush="#FFE0D6B8" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="Bold" Text="Professor Session Dashboard" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF5F5A4E"
                                   Text="Open a lecture session, send sample content, and test a local RDP integration spike from the same window."
                                   TextWrapping="Wrap" />

                        <UniformGrid Margin="0,20,0,0" Columns="2">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock FontWeight="SemiBold" Text="Session Name" />
                                <TextBox Margin="0,6,0,0" Padding="10,8" Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock FontWeight="SemiBold" Text="Port" />
                                <TextBox Margin="0,6,0,0" Padding="10,8" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                        <WrapPanel Margin="0,20,0,0">
                            <Button Margin="0,0,10,10" Padding="18,10" Command="{Binding OpenSessionCommand}" Content="Open Session" />
                            <Button Margin="0,0,10,10" Padding="18,10" Command="{Binding CloseSessionCommand}" Content="Close Session" />
                            <Button Margin="0,0,10,10" Padding="18,10" Command="{Binding StartScreenShareCommand}" Content="Send Preview Frame" />
                            <Button Margin="0,0,10,10" Padding="18,10" Command="{Binding SendSampleFileCommand}" Content="Send Sample File" />
                        </WrapPanel>

                        <Border Margin="0,14,0,0" Padding="16" Background="White" BorderBrush="#FFE0D6B8" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Screen Sharing Status" />
                                <TextBlock Margin="0,8,0,0" Text="{Binding LatestScreenStatus}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="16" Background="White" BorderBrush="#FFE0D6B8" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="RDP Integration Test" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#FF5F5A4E"
                                           Text="This uses the built-in Microsoft Remote Desktop ActiveX control inside a WPF WindowsFormsHost."
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="RDP Server" />
                                <TextBox Margin="0,6,0,0" Padding="10,8" Text="{Binding RdpServerAddress, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="User Name" />
                                <TextBox Margin="0,6,0,0" Padding="10,8" Text="{Binding RdpUserName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Password" />
                                <TextBox Margin="0,6,0,0" Padding="10,8" Text="{Binding RdpPassword, UpdateSourceTrigger=PropertyChanged}" />

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Margin="0,0,10,10" Padding="18,10" Command="{Binding StartRdpPreviewCommand}" Content="Start RDP" />
                                    <Button Margin="0,0,10,10" Padding="18,10" Command="{Binding StopRdpPreviewCommand}" Content="Stop RDP" />
                                </WrapPanel>

                                <TextBlock Margin="0,4,0,0" Text="{Binding RdpStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="Realtime Chat" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Width="110" Margin="12,0,0,0" Command="{Binding SendChatCommand}" Content="Send Message" />
                            <TextBox Padding="10,8" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ListBox Margin="0,10,0,0" Height="160" ItemsSource="{Binding ChatMessages}" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="12" Background="White" BorderBrush="#FFE0D6B8" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <TextBlock Margin="8"
                                       VerticalAlignment="Top"
                                       Panel.ZIndex="1"
                                       Background="#CCFFFFFF"
                                       FontWeight="SemiBold"
                                       Text="RDP Preview Surface" />
                            <wfi:WindowsFormsHost x:Name="RdpPreviewHost" Margin="0,28,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Padding="16" Background="White" BorderBrush="#FFE0D6B8" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Shared Files" />
                            <ListBox Margin="0,10,0,0" Height="120" ItemsSource="{Binding SharedFiles}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Padding="16" Background="White" BorderBrush="#FFE0D6B8" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Activity Log" />
                            <ListBox Margin="0,10,0,0" ItemsSource="{Binding ActivityLogs}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
