<Window x:Class="EduStream.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EduStream.Server"
        mc:Ignorable="d"
        Title="EduStream 교수자"
        Height="840"
        Width="1460"
        MinHeight="760"
        MinWidth="1200"
        Background="{DynamicResource BrushBgPrimary}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="StudentScreenTemplate">
            <local:StudentScreenView Margin="0,10,0,0"
                Model="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DataTemplate>
        <!-- 모니터 선택 콤보박스: 앱 테마에 맞춘 다크 스타일 -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BrushBgElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid Margin="{TemplateBinding Padding}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" />
                                                <Path Grid.Column="1" Data="M0,0 L4,4 8,0" Stroke="{DynamicResource BrushTextMuted}"
                                                      StrokeThickness="1.4" Margin="8,0,2,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Margin="2,0,0,0" VerticalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource BrushBgElevated}" BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1" CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 비활성(엔진 연결 전)이어도 글자는 읽을 수 있게 흐리게만 한다. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Toggle" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{DynamicResource BrushBgElevated}"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{DynamicResource BrushTextPrimary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background"
                                                    Value="{DynamicResource BrushAccentPurple}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 방 비밀번호 입력란: 다른 입력칸과 같은 어두운 톤 -->
        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource BrushBgElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="360" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="1*" MinWidth="360" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="1*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- ============ 1열: 세션 관리 / 채팅 ============ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" MinHeight="260" />
            </Grid.RowDefinitions>

            <!-- 세션 관리 -->
            <!-- 헤더 한 줄: 세션 관리 · 참가 학생 · (오른쪽) 세션 열기 또는 세션 닫기. 세션이 열리면 접고 닫히면 펼친다(MainWindow.xaml.cs). -->
            <Border Grid.Row="0" Style="{StaticResource PanelCard}">
                <Expander x:Name="SessionExpander" IsExpanded="True" HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}">
                    <Expander.Header>
                        <DockPanel LastChildFill="True" Height="36">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource ThemeToggleGlyph}" FontFamily="Segoe MDL2 Assets" Click="ToggleTheme_Click"
                                    ToolTip="{DynamicResource ThemeToggleLabel}" AutomationProperties.Name="{DynamicResource ThemeToggleLabel}" Style="{StaticResource GhostButton}" Margin="4,0" />
                            <!-- 열렸을 때는 세션 닫기만, 닫혀 있을 때는 세션 열기만 보인다. 크기는 같다. -->
                            <Button DockPanel.Dock="Right" Width="84" Height="34"
                                    Margin="8,0,4,0" VerticalAlignment="Center"
                                    Content="세션 열기" Command="{Binding OpenSessionCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Width="84" Height="34"
                                    Margin="8,0,4,0" VerticalAlignment="Center"
                                    Content="세션 닫기" Command="{Binding CloseSessionCommand}"
                                    Visibility="{Binding IsSessionOpen, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="⚙ 세션 관리" VerticalAlignment="Center" />
                                <Border Margin="8,0,0,0" Height="34" Padding="8,0" VerticalAlignment="Center" CornerRadius="8" ToolTip="지금 참가 중인 학생 수"
                                        Background="{DynamicResource BrushSuccessGround}" BorderBrush="{DynamicResource BrushSuccess}" BorderThickness="1"
                                        Visibility="{Binding IsSessionOpen, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ParticipantCount, StringFormat={}{0}명}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushSuccess}" FontSize="12" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Expander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,6" Text="접속용 교수자 IP" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                Padding="10,0" Content="복사" Click="CopyHostAddress_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                Padding="10,0" Content="새로고침" Click="RefreshHostAddresses_Click" ToolTip="{Binding DiscoveryStatus}" />
                        <ComboBox x:Name="HostAddressSelector" Style="{StaticResource DarkComboBox}" Height="32"
                                  ItemsSource="{Binding HostAddressOptions}"
                                  SelectedItem="{Binding SelectedHostAddress}"
                                  DisplayMemberPath="Display" />
                    </DockPanel>

                    <Expander Header="고급 설정 (기본 포트 5000)" IsExpanded="False" Margin="0,10,0,0"
                              Foreground="{DynamicResource BrushTextSecondary}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="포트" />
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     IsEnabled="{Binding IsSessionOpen, Converter={StaticResource InverseBool}}"
                                     Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <CheckBox Content="방 비밀번호 사용"
                                      Foreground="{DynamicResource BrushTextSecondary}"
                                      IsEnabled="{Binding IsSessionOpen, Converter={StaticResource InverseBool}}"
                                      IsChecked="{Binding UseRoomPassword}" />
                            <PasswordBox x:Name="RoomPasswordBox" Style="{StaticResource DarkPasswordBox}" Margin="0,8,0,0"
                                         Visibility="{Binding UseRoomPassword, Converter={StaticResource BoolToVis}}"
                                         IsEnabled="{Binding IsSessionOpen, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,14,0,0" Padding="10" CornerRadius="8" Background="{DynamicResource BrushBgElevated}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentTeal}" />
                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentError}" />
                                        <Setter Property="Background" Value="{DynamicResource BrushErrorGround}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentTeal}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentError}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
                </Expander>
            </Border>

            <!-- 채팅 -->
            <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Content="중요 공지" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                                Command="{Binding ComposeImportantAnnouncementCommand}" ToolTip="학생이 닫을 때까지 표시" />
                        <Button DockPanel.Dock="Right" Content="공지" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                                Command="{Binding ComposeAnnouncementCommand}" ToolTip="3초 표시 후 공지함에 보관" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                Content="{Binding ChatReading.NewMessagesText}" Click="NewChat_Click"
                                Visibility="{Binding ChatReading.HasUnread, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="💬 채팅" />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource BrushBgElevated}" Padding="12" Margin="0,0,0,12"
                                Visibility="{Binding IsAnnouncementComposerOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseAnnouncementComposerCommand}" Style="{StaticResource GhostButton}"
                                            AutomationProperties.Name="공지 작성 닫기" ToolTip="닫기 · 작성 내용 유지" />
                                    <TextBlock Text="{Binding AnnouncementTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBox x:Name="AnnouncementInputBox" Text="{Binding AnnouncementInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" MaxLength="500" AutomationProperties.Name="공지 내용" />
                                <TextBlock Style="{StaticResource CompactStatusText}" Text="{Binding AnnouncementError}" Foreground="{DynamicResource BrushAccentError}" />
                                <Button Content="공지 전송" Command="{Binding PublishAnnouncementCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Conversations.Summary}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <ComboBox Style="{StaticResource ConversationSelector}" ItemsSource="{Binding Conversations.Items}" SelectedItem="{Binding Conversations.Selected}"
                                      AutomationProperties.Name="채팅 상대" />
                        </StackPanel>
                        <Expander DockPanel.Dock="Top" Header="보낸 공지 · 수신/확인 현황" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8">
                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding AnnouncementDeliveries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,8,8,12">
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                    <TextBlock.Style><Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsImportant}" Value="True"><Setter Property="FontWeight" Value="Bold" /></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                        <ListBox x:Name="ChatListBox" Style="{StaticResource DarkListBox}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding Conversations.Selected.Messages}" ItemTemplate="{StaticResource ChatBubbleTemplate}" />
                    </DockPanel>
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Width="72" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}" Content="전송" Command="{Binding SendChatCommand}" />
                        <Grid>
                            <TextBox Style="{StaticResource DarkTextBox}"
                                     TextWrapping="Wrap" MaxHeight="90"
                                     PreviewKeyDown="ChatInput_PreviewKeyDown"
                                     Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" />
                            <!-- 입력칸이 비어 있을 때만 보이는 안내 문구. 클릭은 아래 입력칸으로 통과한다. -->
                            <TextBlock Text="채팅 입력 · Enter 전송, Shift+Enter 줄바꿈" IsHitTestVisible="False" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 2열: 화면 공유 / 세션 파일 / 활동 로그 ============ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 화면 공유 -->
            <Border Grid.Row="0" Style="{StaticResource PanelCard}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="모니터" Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                            <ComboBox x:Name="MonitorSelector" Style="{StaticResource DarkComboBox}" Width="210" Height="28"
                                      ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="Label"
                                      IsEnabled="{Binding CanSelectMonitor}" ToolTip="공유를 멈춘 뒤 모니터를 바꿀 수 있습니다. 학생은 다시 입력하지 않아도 자동 연결됩니다." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="🖥 화면 공유" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="34"
                                Content="공유 시작" Command="{Binding StartRdpShareCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="34"
                                Content="공유 멈춤" Command="{Binding StopRdpShareCommand}" />
                        <!-- 실제 판서 실행은 엔진 연결 전까지 비활성. 아래 설정 UI는 독립적으로 준비합니다. -->
                        <ToggleButton x:Name="DrawingToggle" Grid.Column="4" Height="34"
                                      IsEnabled="{Binding IsRdpSharing}"
                                      ToolTip="선택 모니터 위에 그립니다. Esc 또는 '판서 끝내기'를 누르면 그림을 남긴 채 화면 조작으로 돌아갑니다."
                                      Click="DrawingToggle_Click">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{DynamicResource BrushDrawingButton}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrushOnStrong}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushDrawingHover}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Content" Value="✏ 판서 시작" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushDangerButton}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushDangerHover}" />
                                            <Setter Property="Content" Value="✏ 판서 끝내기" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRdpSharing}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource BrushSuccess}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Foreground="{DynamicResource BrushAccentTeal}" FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Text="{Binding RdpStatus}" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- 세션 파일 -->
            <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="📁 세션 파일" />

                    <Border x:Name="FileDropZone" AllowDrop="True" Margin="0,10,0,0" Padding="10"
                            BorderBrush="{DynamicResource BrushAccentPurple}" BorderThickness="1" CornerRadius="8"
                            Background="Transparent"
                            DragOver="FileDropZone_DragOver" Drop="FileDropZone_Drop">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="파일 선택"
                                    Command="{Binding SelectFileCommand}" />
                            <TextBlock Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFilePath}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SelectedFileName}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFilePath}" Value="">
                                                <Setter Property="Text" Value="파일 끌어 놓기" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <Button Style="{StaticResource GhostButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Content="목록에 등록" Command="{Binding RegisterSelectedFileCommand}" />

                    <TextBlock Style="{StaticResource CompactStatusText}" Margin="0,8,0,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"
                               TextWrapping="Wrap" Text="{Binding FileShareStatus}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,6" Text="강의 파일" />
                    <Grid>
                        <ListBox x:Name="RegisteredFileList" Height="120" Style="{StaticResource DarkListBox}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ItemsSource="{Binding RegisteredFiles}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,0"
                                                Content="×" Command="{Binding UnregisterCommand}" ToolTip="공유 해제 · 원본 파일 유지" AutomationProperties.Name="파일 공유 해제" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,0" Margin="0,0,4,0"
                                                Content="{Binding SendLabel}" Command="{Binding SendAllCommand}" ToolTip="현재 접속한 모든 학생에게 전송" />
                                        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="파일을 끌어 놓거나 선택한 뒤 '목록에 등록'을 누르면 학생이 내려받을 수 있습니다." IsHitTestVisible="False" Margin="12,10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushTextMuted}" FontSize="12"
                                   Visibility="{Binding HasItems, ElementName=RegisteredFileList, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    </Grid>

                    <Expander Header="{Binding SubmissionHeader}" IsExpanded="False" Margin="0,8,0,0" Foreground="{DynamicResource BrushTextSecondary}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding SubmissionStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="{Binding SubmissionToggleText}" Command="{Binding ToggleSubmissionsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6" />
                                <Button Content="제출 폴더 열기" Command="{Binding OpenSubmissionsFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,6" />
                            </WrapPanel>
                            <Grid>
                                <ListBox x:Name="SubmissionList" Height="140" Style="{StaticResource DarkListBox}" ItemsSource="{Binding SubmissionReceipts}">
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <DockPanel Margin="0,4" ToolTip="{Binding LocalPath}">
                                            <Button DockPanel.Dock="Right" Content="파일 위치" Command="{Binding RevealCommand}" Style="{StaticResource GhostButton}" Padding="8,0"
                                                    VerticalAlignment="Center" ToolTip="파일을 실행하지 않고 탐색기에서 선택합니다" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"><Run Text="{Binding Student, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TimeText, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="'제출 열기'를 누르면 학생이 파일을 보낼 수 있습니다. 받은 파일이 여기에 보입니다." IsHitTestVisible="False" Margin="12,10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextMuted}" FontSize="12"
                                           Visibility="{Binding HasItems, ElementName=SubmissionList, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <Expander Header="학생별 다운로드 현황" IsExpanded="False" Margin="0,8,0,0" Foreground="{DynamicResource BrushTextSecondary}">
                        <StackPanel Margin="0,8,0,0">
                            <Grid>
                                <ListBox x:Name="DeliveryList" Height="140" Style="{StaticResource DarkListBox}" ItemsSource="{Binding FileDeliveries}">
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"><Run Text="{Binding Student}" /><Run Text=" · " /><Run Text="{Binding Status}" /></TextBlock>
                                        </StackPanel>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="학생이 강의 파일을 내려받으면 여기에 보입니다." IsHitTestVisible="False" Margin="12,10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushTextMuted}" FontSize="12"
                                           Visibility="{Binding HasItems, ElementName=DeliveryList, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 활동 로그: 작은 기본 접힘 영역. 중요한 실패는 세션 관리의 상태 안내와 화면 공유의 상태 줄에 따로 표시된다. -->
            <Border Grid.Row="4" Style="{StaticResource PanelCard}" VerticalAlignment="Top">
                <Expander Header="📑 활동 로그" IsExpanded="False" Foreground="{DynamicResource BrushTextPrimary}">
                    <ListBox Height="140" Margin="0,10,0,0" Style="{StaticResource DarkListBox}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding ActivityLogs}" ItemTemplate="{StaticResource LogLineTemplate}" />
                </Expander>
            </Border>
        </Grid>

        </ScrollViewer>

        <!-- ============ 3열: 학생 목록 ============ -->
        <Border Grid.Column="4" Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Margin="0,0,4,0" Padding="8,4" FontSize="11"
                                Content="모두 펼치기" Click="ExpandAllStudents_Click" />
                        <Button Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11"
                                Content="모두 접기" Click="CollapseAllStudents_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="👥 학생 목록" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="찾기" Style="{StaticResource GhostButton}"
                            Margin="6,0,0,0" Click="FindStudent_Click" />
                    <Grid>
                        <TextBox x:Name="StudentSearchBox" Style="{StaticResource DarkTextBox}"
                                 ToolTip="이름이나 학번 일부 입력 · Enter로 다음 일치 학생 찾기"
                                 PreviewKeyDown="StudentSearch_PreviewKeyDown" />
                        <!-- 비어 있을 때만 보이는 안내. 클릭은 입력칸으로 통과한다. -->
                        <TextBlock Text="이름·학번 검색 (Enter: 다음)" IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=StudentSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <TextBlock x:Name="StudentSearchResult" Margin="0,4,0,0" TextWrapping="Wrap"
                           FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                <TextBlock Text="{Binding AttendanceSummary}" Margin="0,6,0,0" Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>

                <ScrollViewer x:Name="StudentListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <Expander Header="명단 관리" IsExpanded="False" Margin="0,0,0,10"
                          Foreground="{DynamicResource BrushTextSecondary}">
                    <StackPanel Margin="0,8,0,0">
                        <Button Content="학생명단 가져오기 (.xlsx)" Command="{Binding PreviewRosterCommand}" Style="{StaticResource GhostButton}" />
                        <TextBlock Text="{Binding RosterImportStatus}" Style="{StaticResource CompactStatusText}" Margin="0,8,0,8" />
                        <WrapPanel>
                            <Button Content="명단 대조 켜기" Command="{Binding ApplyRosterAdmissionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6" />
                            <Button Content="명단 대조 끄기" Command="{Binding DisableRosterAdmissionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding RosterAdmissionStatus}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" />
                        <Button Content="접속 기록 CSV 저장" Command="{Binding ExportAttendanceCommand}" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Expander>
                    <ItemsControl x:Name="StudentListItems" ItemsSource="{Binding StudentRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Background="{DynamicResource BrushStudentCard}" CornerRadius="8"
                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                    <StackPanel Margin="10">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Top" Margin="6,0,0,0" Padding="6,4"
                                                      IsChecked="{Binding IsHistoryExpanded, Mode=TwoWay}" AutomationProperties.Name="입퇴장 기록 펼치기/접기">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="기록 ▾" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                                                    <Setter Property="Background" Value="{DynamicResource BrushBgElevated}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template"><Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value></Setter>
                                                    <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="기록 ▴" /></Trigger></Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    <Expander x:Name="StudentExpander" IsExpanded="{Binding IsScreenExpanded, Mode=TwoWay}"
                                              IsEnabled="{Binding IsConnected}" BorderThickness="0" Padding="0">
                                        <Expander.Resources>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                                            </Style>
                                        </Expander.Resources>
                                        <Expander.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StudentId}" Style="{StaticResource CompactStatusText}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <TextBlock Text="{Binding Status}" FontSize="11">
                                                    <TextBlock.Style><Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" /></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander.Header>
                                        <ContentControl Content="{Binding ParticipantName}" HorizontalContentAlignment="Stretch">
                                            <ContentControl.Style><Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate /></Setter.Value></Setter>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource StudentScreenTemplate}" />
                                                </DataTrigger></Style.Triggers>
                                            </Style></ContentControl.Style>
                                        </ContentControl>
                                    </Expander>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Issue}" Style="{StaticResource CompactStatusText}" Foreground="{DynamicResource BrushAccentError}" />
                                    <StackPanel Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                        <TextBlock Text="입퇴장 기록 없음" Foreground="{DynamicResource BrushTextMuted}">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate>
                                            <TextBlock Margin="0,3" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap">
                                                <Run Text="{Binding At, StringFormat=MM/dd HH:mm:ss}" /><Run Text=" · " /><Run Text="{Binding Action}" />
                                            </TextBlock>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
