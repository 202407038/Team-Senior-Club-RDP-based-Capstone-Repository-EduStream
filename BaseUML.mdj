        <mxCell id="300" value="&lt;b&gt;Bulk File Transfer Sequence&lt;/b&gt;" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#f8fafc;align=center;" vertex="1" parent="1">
          <mxGeometry x="760" y="8" width="800" height="34" as="geometry"/>
