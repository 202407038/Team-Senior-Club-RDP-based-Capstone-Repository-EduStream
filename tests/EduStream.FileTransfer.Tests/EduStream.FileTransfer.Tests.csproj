<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="EduStream.ShareHost" />
  </ItemGroup>

  <ItemGroup>
    <!-- 역방향 E2E 테스트가 교수자 측 실제 AxRDPViewer 를 직접 생성하기 위한 참조 (Client 와 동일한 interop 사용) -->
    <Reference Include="AxRDPCOMAPILib">
      <HintPath>..\..\src\EduStream.Client\libs\AxRDPCOMAPILib.dll</HintPath>
    </Reference>
    <Reference Include="RDPCOMAPILib">
      <HintPath>..\..\src\EduStream.Client\libs\RDPCOMAPILib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EduStream.Core\EduStream.Core.csproj" />
    <ProjectReference Include="..\..\src\EduStream.Client\EduStream.Client.csproj" />
    <ProjectReference Include="..\..\src\EduStream.Server\EduStream.Server.csproj" />
    <ProjectReference Include="..\..\src\EduStream.ShareHost\EduStream.ShareHost.csproj" />
    <ProjectReference Include="..\..\src\EduStream.ShareViewer\EduStream.ShareViewer.csproj" />
    <ProjectReference Include="..\..\tools\EduStream.ContractTestDoubles\EduStream.ContractTestDoubles.csproj" />
  </ItemGroup>

</Project>
